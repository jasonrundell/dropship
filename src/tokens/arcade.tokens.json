{
  "$description": "Neo-brutalist: heavy black outlines, hard offset shadows, and saturated colour. Proves elevation can be a solid offset rather than a blur.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 0.9843, 0.9216],
        "hex": "#fffbeb"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "surfaceAlt": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 0.9765, 0.8902],
        "hex": "#fff9e3"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000"
      }
    },
    "textMuted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2667, 0.251, 0.2353],
        "hex": "#44403c"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8549, 0.1098, 0.349],
        "hex": "#da1c59"
      }
    },
    "onPrimary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.8, 0.0824],
        "hex": "#facc15"
      }
    },
    "onAccent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4275, 0.1569, 0.851],
        "hex": "#6d28d9"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0824, 0.502, 0.2392],
        "hex": "#15803d"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7059, 0.3255, 0.0353],
        "hex": "#b45309"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.149, 0.149],
        "hex": "#dc2626"
      }
    },
    "onError": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "3xs": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2xs": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      }
    },
    "xs": {
      "$value": {
        "value": 0.625,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 3.5,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 5,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "full": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    }
  },
  "borderWidth": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "hairline": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "thin": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "thick": {
      "$value": {
        "value": 5,
        "unit": "px"
      }
    }
  },
  "borderStyle": {
    "$type": "strokeStyle",
    "default": {
      "$value": "solid"
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": {
      "$value": "none"
    },
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 1
        },
        "offsetX": {
          "value": 2,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 1
        },
        "offsetX": {
          "value": 4,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 1
        },
        "offsetX": {
          "value": 8,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"]
    },
    "heading": {
      "$value": [
        "Archivo Black",
        "Arial Black",
        "Archivo",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": ["Space Mono", "Andale Mono", "Consolas", "monospace"]
    }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.8125,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.9375,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1.0625,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 2.75,
        "unit": "rem"
      }
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 500
    },
    "medium": {
      "$value": 700
    },
    "bold": {
      "$value": 900
    },
    "heading": {
      "$value": 900
    }
  },
  "lineHeight": {
    "$type": "number",
    "tight": {
      "$value": 1.05
    },
    "normal": {
      "$value": 1.5
    },
    "loose": {
      "$value": 1.7
    }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": {
      "$value": {
        "value": -0.03,
        "unit": "em"
      }
    },
    "normal": {
      "$value": {
        "value": 0,
        "unit": "em"
      }
    },
    "wide": {
      "$value": {
        "value": 0.06,
        "unit": "em"
      }
    },
    "heading": {
      "$value": {
        "value": -0.04,
        "unit": "em"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 60,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 110,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 180,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    },
    "entrance": {
      "$value": [0, 0, 0.2, 1]
    },
    "exit": {
      "$value": [0.4, 0, 1, 1]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 30,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 48,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 64,
        "unit": "rem"
      }
    }
  },
  "zIndex": {
    "$type": "number",
    "base": {
      "$value": 1
    },
    "overlay": {
      "$value": 10
    },
    "nav": {
      "$value": 100
    },
    "modal": {
      "$value": 1000
    }
  },
  "layout": {
    "$type": "string",
    "$description": "Media pushed to the right, text leading.",
    "cardAreas": {
      "$value": "\"title media\" \"body media\" \"actions media\""
    },
    "cardColumns": {
      "$value": "1fr 8rem"
    }
  }
}
