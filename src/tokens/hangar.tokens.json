{
  "$description": "Instrumentation: monospaced headings with wide tracking, sharp corners, and precise hairlines. The default design. Restrained everywhere except where something needs to be read at a glance.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9804, 0.9765],
        "hex": "#fafaf9"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0431],
        "hex": "#0a0a0b"
      }
    },
    "textMuted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3412, 0.3255, 0.3059],
        "hex": "#57534e"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8392, 0.8275, 0.8196],
        "hex": "#d6d3d1"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7608, 0.2549, 0.0471],
        "hex": "#c2410c"
      }
    },
    "onPrimary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0588, 0.4627, 0.4314],
        "hex": "#0f766e"
      }
    },
    "onAccent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0118, 0.4118, 0.6314],
        "hex": "#0369a1"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0824, 0.502, 0.2392],
        "hex": "#15803d"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6314, 0.3843, 0.0275],
        "hex": "#a16207"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7255, 0.1098, 0.1098],
        "hex": "#b91c1c"
      }
    },
    "onError": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "3xs": {
      "$value": {
        "value": 0.125,
        "unit": "rem"
      }
    },
    "2xs": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "xs": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "borderWidth": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "hairline": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "thin": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "thick": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "borderStyle": {
    "$type": "strokeStyle",
    "default": {
      "$value": "solid"
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": {
      "$value": "none"
    },
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0392, 0.0431],
          "hex": "#0a0a0b",
          "alpha": 0.12
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0392, 0.0431],
          "hex": "#0a0a0b",
          "alpha": 0.14
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0392, 0.0431],
          "hex": "#0a0a0b",
          "alpha": 0.16
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 6,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": [
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "heading": {
      "$value": [
        "Berkeley Mono",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    },
    "mono": {
      "$value": [
        "Berkeley Mono",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.375,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 2.25,
        "unit": "rem"
      }
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "bold": {
      "$value": 700
    },
    "heading": {
      "$value": 600
    }
  },
  "lineHeight": {
    "$type": "number",
    "tight": {
      "$value": 1.2
    },
    "normal": {
      "$value": 1.55
    },
    "loose": {
      "$value": 1.8
    }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": {
      "$value": {
        "value": -0.01,
        "unit": "em"
      }
    },
    "normal": {
      "$value": {
        "value": 0,
        "unit": "em"
      }
    },
    "wide": {
      "$value": {
        "value": 0.04,
        "unit": "em"
      }
    },
    "heading": {
      "$value": {
        "value": 0.08,
        "unit": "em"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 90,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 160,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 280,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    },
    "entrance": {
      "$value": [0, 0, 0.2, 1]
    },
    "exit": {
      "$value": [0.4, 0, 1, 1]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 30,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 48,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 64,
        "unit": "rem"
      }
    }
  },
  "zIndex": {
    "$type": "number",
    "base": {
      "$value": 1
    },
    "overlay": {
      "$value": 10
    },
    "nav": {
      "$value": 100
    },
    "modal": {
      "$value": 1000
    }
  },
  "layout": {
    "$type": "string",
    "$description": "Dense and technical: media pinned left in a fixed column.",
    "cardAreas": {
      "$value": "\"media title\" \"media body\" \"media actions\""
    },
    "cardColumns": {
      "$value": "9rem 1fr"
    }
  }
}
