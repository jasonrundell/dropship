{
  "name": "@jasonrundell/dropship",
  "version": "3.4.0",
  "description": "Get a React project up and running really fast with Dropship.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npm run storybook",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/emit-cjs-types.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "auto shipit --base-branch=main",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint --strict && attw --pack . --exclude-entrypoints style.css",
    "prettier": "prettier --write .",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "auto": "^11.2.1",
    "axe-core": "^4.12.1",
    "chromatic": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.6",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.3",
    "publint": "^0.3.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonrundell/dropship.git"
  },
  "bugs": {
    "url": "https://github.com/jasonrundell/dropship/issues"
  },
  "author": "Jason Rundell <jason.rundell@gmail.com>",
  "homepage": "https://github.com/jasonrundell/dropship#readme",
  "keywords": [
    "react",
    "vite",
    "storybook",
    "typescript"
  ]
}
