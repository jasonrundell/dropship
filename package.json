{
  "name": "@jasonrundell/dropship",
  "version": "3.4.0",
  "description": "Get a React project up and running really fast with Dropship.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npm run storybook",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/emit-cjs-types.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "auto shipit --base-branch=main",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint --strict && attw --pack . --exclude-entrypoints style.css",
    "prettier": "prettier --write .",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@pigment-css/react": "0.0.29",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@chromatic-com/storybook": "^3.2.2",
    "@eslint/js": "^9.13.0",
    "@pigment-css/react": "^0.0.29",
    "@pigment-css/vite-plugin": "^0.0.29",
    "@storybook/addon-essentials": "^8.4.2",
    "@storybook/addon-interactions": "^8.4.2",
    "@storybook/addon-onboarding": "^8.4.2",
    "@storybook/blocks": "^8.4.2",
    "@storybook/react": "^8.4.2",
    "@storybook/react-vite": "^8.4.2",
    "@storybook/test": "^8.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "auto": "^11.2.1",
    "axe-core": "^4.12.1",
    "chromatic": "^7.2.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^0.11.0",
    "globals": "^15.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.3",
    "publint": "^0.3.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonrundell/dropship.git"
  },
  "bugs": {
    "url": "https://github.com/jasonrundell/dropship/issues"
  },
  "author": "Jason Rundell <jason.rundell@gmail.com>",
  "homepage": "https://github.com/jasonrundell/dropship#readme",
  "keywords": [
    "react",
    "vite",
    "storybook",
    "typescript"
  ]
}
